# KHUNG MẪU — WORKFLOW GITHUB ACTIONS cho MỘT loại nội dung.
# Copy thành .github/workflows/<loại>-build.yml rồi sửa các chỗ  # >>> SỬA
#
# Chạy: (a) repository_dispatch do Apps Script bắn đúng giờ, (b) workflow_dispatch bấm tay.
# KHÔNG dùng cron GitHub (hay trễ) — để Apps Script lo hẹn giờ + chống trùng theo ngày.

name: <loai>-build                       # >>> SỬA

on:
  workflow_dispatch:
    inputs:
      frame:
        description: "daily | weekly"
        required: false
        default: "daily"
        type: choice
        options: ["daily", "weekly"]
      date:
        description: "Ngày DD/MM/YYYY (bỏ trống = auto)"
        required: false
        type: string
  repository_dispatch:
    types: [<loai>-daily, <loai>-weekly]   # >>> SỬA type (khớp Apps Script)

permissions:
  contents: write

concurrency:
  group: <loai>-build                      # >>> SỬA (chặn chạy chồng)
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 40
    steps:
      - name: Checkout render-ci
        uses: actions/checkout@v4

      # >>> SỬA/BỎ nếu brain KHÔNG cần dữ liệu ngoài. Kiểu B (số liệu) thường cần repo bias-web:
      - name: Lấy số liệu (repo public bias-web)
        uses: actions/checkout@v4
        with:
          repository: kenvinzone-stockai/kenvinzone-bias-web
          path: bias-web

      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }

      - name: Xác định ngày + khung
        id: cfg
        env:
          PAYLOAD_DATE: ${{ github.event.client_payload.date }}
          INPUT_DATE: ${{ github.event.inputs.date }}
          ACTION: ${{ github.event.action }}
          INPUT_FRAME: ${{ github.event.inputs.frame }}
        run: |
          D="${PAYLOAD_DATE:-$INPUT_DATE}"
          if [ "$ACTION" = "<loai>-weekly" ]; then FRAME="weekly"       # >>> SỬA
          elif [ -n "$INPUT_FRAME" ]; then FRAME="$INPUT_FRAME"
          else FRAME="daily"; fi
          echo "date=$D" >> "$GITHUB_OUTPUT"
          echo "frame=$FRAME" >> "$GITHUB_OUTPUT"

      - name: Setup Node 22
        uses: actions/setup-node@v4
        with: { node-version: "22" }

      - name: Install deps
        run: |
          python -m pip install --upgrade pip
          pip install edge-tts elevenlabs playwright
          python -m playwright install --with-deps chromium
          sudo apt-get update && sudo apt-get install -y ffmpeg

      - name: Dựng deck (Gemini)
        id: brain
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
        run: |
          set -o pipefail
          DATE_ARG=""; if [ -n "${{ steps.cfg.outputs.date }}" ]; then DATE_ARG="--date ${{ steps.cfg.outputs.date }}"; fi
          # >>> SỬA lệnh brain cho đúng loại:
          #   Kiểu A (tin):   python build_<loai>_deck.py --url "<link>" $DATE_ARG
          #   Kiểu B (dữ liệu): python build_<loai>_deck.py --data bias-web/data/latest.json --frame "${{ steps.cfg.outputs.frame }}" $DATE_ARG
          python build_<loai>_deck.py --data bias-web/data/latest.json --frame "${{ steps.cfg.outputs.frame }}" $DATE_ARG 2>&1 | tee brain.log
          PROJ=$(grep -oP 'PROJECT=\K\S+' brain.log | tail -1)
          echo "proj=$PROJ" >> "$GITHUB_OUTPUT"
          test -n "$PROJ"

      - name: Render giọng clone + upload Private
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          TTS_CONFIG_JSON: ${{ secrets.TTS_CONFIG_JSON }}
          SOCIAL_UPLOAD_JSON: ${{ secrets.SOCIAL_UPLOAD_JSON }}
          YT_CHANNEL_ID: ${{ secrets.<LOAI>_YT_CHANNEL_ID || secrets.YT_CHANNEL_ID }}  # >>> SỬA
          HYPERFRAMES_NO_TELEMETRY: "1"
        run: |
          set -o pipefail
          python ci_build_video.py "slide/${{ steps.brain.outputs.proj }}" --privacy private 2>&1 | tee -a ci-run.log

      - name: Commit log + last-upload
        if: always()
        run: |
          mkdir -p ci-logs
          cp brain.log  "ci-logs/<loai>-brain-${{ github.run_id }}.log" 2>/dev/null || true
          cp ci-run.log "ci-logs/<loai>-run-${{ github.run_id }}.log"  2>/dev/null || true
          git config user.name "ci-bot"; git config user.email "ci@kenvinzone.local"
          git add -A && git commit -m "<loai> ${{ steps.brain.outputs.proj }} (run ${{ github.run_id }})" || true
          git pull --rebase || true
          git push || true

      - name: Báo Telegram
        if: always()
        env:
          TG: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          CHAT: ${{ secrets.TELEGRAM_CHAT_ID }}
          PROJ: ${{ steps.brain.outputs.proj }}
        run: |
          [ -z "$TG" ] || [ -z "$CHAT" ] && exit 0
          if [ -f upload-result.json ]; then
            URL=$(python3 -c "import json;print(json.load(open('upload-result.json')).get('url',''))" 2>/dev/null)
            MSG="✅ Xong video <LOẠI> [$PROJ] — PRIVATE:
          $URL
          Xem xong nhắn \"duyệt\" để công khai."
          else
            MSG="❌ Lỗi khi dựng <LOẠI> [$PROJ]. Xem ci-logs/ trong repo."
          fi
          curl -s -X POST "https://api.telegram.org/bot$TG/sendMessage" --data-urlencode chat_id="$CHAT" --data-urlencode text="$MSG" -o /dev/null || true

      - name: Lưu video (artifact)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: <loai>-${{ steps.brain.outputs.proj }}
          path: |
            slide/${{ steps.brain.outputs.proj }}/output/final_video.mp4
            upload-result.json
          if-no-files-found: warn
          retention-days: 14
